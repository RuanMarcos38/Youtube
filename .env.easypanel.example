APP_NAME=ShortsFlow AI
FRONTEND_URL=https://$(PRIMARY_DOMAIN)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_VIDEO_ENABLED=true
GEMINI_API_KEY=
VEO_FAST_MODEL=veo-3.1-fast-generate-preview
VEO_QUALITY_MODEL=veo-3.1-generate-preview
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=
YOUTUBE_OAUTH_REDIRECT_URI=https://$(PRIMARY_DOMAIN)/api/youtube/oauth/callback
YOUTUBE_DEFAULT_REGION=BR
YOUTUBE_DEFAULT_PRIVACY=private
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_B64=
YTDLP_PROXY_URL=
YTDLP_POT_PROVIDER_URL=
YTDLP_NODE_PATH=/usr/local/bin/node
WORKER_POLL_SECONDS=2
