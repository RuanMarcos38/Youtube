APP_NAME=ShortsFlow AI
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SQLITE_PATH=data/app.db
DATA_DIR=data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_LANGUAGE=
LOCAL_WHISPER_BEAM_SIZE=3
ALLOW_OPENAI_TRANSCRIPTION_FALLBACK=false
CLIP_PLANNING_PROVIDER=local
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
YOUTUBE_DEFAULT_REGION=BR
YOUTUBE_DEFAULT_PRIVACY=private
YTDLP_COOKIE_FILE=
YTDLP_POT_PROVIDER_URL=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WORKER_POLL_SECONDS=2
